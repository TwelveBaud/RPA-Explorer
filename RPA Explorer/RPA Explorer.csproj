<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>RPA_Explorer</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>default</LangVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Nullable>disable</Nullable>
    <ApplicationIcon>images\RPA Explorer.ico</ApplicationIcon>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Platforms>AnyCPU</Platforms>
    <VersionPrefix>1.1.0</VersionPrefix>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Authors>UniverseDevel, TwelveBaud</Authors>
    <Copyright>Copyright ©2022-2026 Martin Suchy, Andrew Cook</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/TwelveBaud/RPA-Explorer</RepositoryUrl>
    <Configurations>Debug;Release;Minimal</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>TRACE;</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>TRACE;</DefineConstants>
  </PropertyGroup>
 
  <PropertyGroup Condition=" '$(Configuration)' == 'Minimal' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>TRACE;MINIMAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ArchiveSave.cs" />
    <Compile Remove="ArchiveSave.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft-Windows10-APICodePack-Shell" Version="1.1.8" Condition=" '$(Configuration)' != 'Minimal' " />
    <PackageReference Include="NeoSmart.PrettySize" Version="2.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" Condition=" '$(Configuration)' != 'Minimal' " />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" Condition=" '$(Configuration)' != 'Minimal' " />
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="System.Resources.Extensions" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="About.resx" />
    <EmbeddedResource Include="Lang.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Lang.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="MainWindow.resx" />
    <EmbeddedResource Include="Previewers\ImagePreviewControl.resx" />
    <EmbeddedResource Include="Previewers\MediaStubControl.resx" />
    <EmbeddedResource Include="Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Lang.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Lang.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPA Parser\RPAParser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>